{% extends "base.twig" %}

{% block content %}
    {% if datos %}
        <h2>Detalles de la Reserva #{{ datos.id }}</h2>
        
        <div>
            <p>Huésped: {{ datos.nombre_huesped }}</p>
            <p>Alojamiento: {{ datos.nombre_alojamiento }}</p>
            <p>Fecha Entrada: {{ datos.fecha_entrada |date("d/m/Y") }}</p>
            <p>Fecha Salida: {{ datos.fecha_salida |date("d/m/Y")}}</p>
            <p>Estado: {{ datos.estado|upper }}</p>
            <p>Importe: {{ datos.importe|number_format(2, ',', '.') }} €</p>
            <p>Notas: {% if datos.notas %} 
                    {{ datos.notas }} 
                {% else %} 
                    Ninguna 
                {% endif %}
            </p>
            <p>Fecha de Creación: {{ datos.fecha_creacion }}</p>
        </div>

        <div>
            <h3>Historial de Eventos</h3>
            <ul>
                {% if historial %}
                    {% for evento in historial %}
                        <li>
                            {{ evento.fecha_creacion }} - {{ evento.tipo }}: {{ evento.descripcion }}
                        </li>
                    {% endfor %}
                {% else %}
                    <li>No hay eventos registrados para esta reserva.</li>
                {% endif %}
            </ul>
        </div>

        <br>
        <a href="{{ RUTA_BASE }}">Volver al listado</a>
    {% else %}
        <h2>La reserva que buscas no existe.</h2>
        <a href="{{ RUTA_BASE }}">Volver al listado</a>
    {% endif %}

{% endblock %}
